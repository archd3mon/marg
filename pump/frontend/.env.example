# Frontend environment variables
#
# LOCAL WEB DEV: leave empty — Vite proxy routes /api/* to http://127.0.0.1:8000
# VITE_API_BASE_URL=
#
# CAPACITOR NATIVE BUILD (required): full HTTPS URL of the deployed backend.
# Copy this file to .env and fill in your Render URL before running `npm run build`.
# VITE_API_BASE_URL=https://marg-api.onrender.com/api/v1
