# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environments — never commit real .env files (they may contain API keys)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook
.ipynb_checkpoints

# pytest
.pytest_cache/

# mypy
.mypy_cache/

# FastAPI / Uvicorn
*.sqlite3

# SQLite WAL files (generated by SQLite, not source)
*.sqlite-shm
*.sqlite-wal

# Node
npm-debug.log

# Project specific
pump/backend/venv
pump/frontend/node_modules
pump/frontend/dist

# Capacitor Android — exclude build artifacts and machine-specific files;
# keep android/app/src/** (AndroidManifest, res/, Java/Kotlin source) in git
pump/frontend/android/.gradle/
pump/frontend/android/app/build/
pump/frontend/android/build/
pump/frontend/android/local.properties

# Capacitor iOS (deferred — exclude when added)
pump/frontend/ios/App/Pods/
pump/frontend/ios/.xcode.env.local
